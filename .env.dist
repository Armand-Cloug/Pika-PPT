# Production : pika-ppt.cloug.fr ; préproduction : preprod.pika-ppt.cloug.fr
DOMAIN=pika-ppt.cloug.fr
# Préférer 1.0.0-build.42.1 ou sha-<SHA complet> pour promotion / rollback.
IMAGE_TAG=1.0.0
AUTH_USERNAME=
# Guillemets simples Compose : $, #, espaces, ! restent littéraux.
# Exemple de syntaxe : AUTH_PASSWORD='une-longue-phrase$avec#symboles!'
# Une apostrophe dans une valeur entre apostrophes s'écrit \' ; pas de saut de ligne.
AUTH_PASSWORD=
